{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hiring-signals-web",
	"main": ".open-next/worker.js",
	// Matches apps/api/wrangler.toml's account_id (same Cloudflare
	// account, "teycircoder14" subdomain, one deployment target per app --
	// see that file's own comments for the account/subdomain history).
	"account_id": "c62f54368e3f6a1f503afa434771b7e4",
	// Set to the day this Worker config was first created (2026-08-16).
	// OpenNext's own docs say "set this to today's date" -- pin, don't
	// auto-advance, so runtime behavior only changes on a deliberate
	// bump, same reasoning apps/api/wrangler.toml's own compatibility_date
	// comment would give.
	"compatibility_date": "2026-08-16",
	// Required by @opennextjs/cloudflare (Cloudflare docs: "you must
	// enable the nodejs_compat compatibility flag ... for your Next.js
	// app to work with @opennextjs/cloudflare"). Distinct requirement
	// from apps/api's own nodejs_compat flag -- each Worker declares it
	// independently, this file doesn't inherit apps/api's config.
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Deploy to workers.dev by default, same as apps/api -- final URL:
	//   https://hiring-signals-web.teycircoder14.workers.dev
	// Swap for a custom `routes`/`domains` entry later if/when this app
	// gets a real domain.
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// Runtime env var for the deployed Worker (W.4, 2026-08-17): .env.production's
	// NEXT_PUBLIC_API_BASE_URL only gets inlined into CLIENT-side bundles at
	// `next build` time -- server-side code (generateMetadata, any Server
	// Component) reads process.env at REQUEST time in the actual Workers
	// runtime, and nothing wires .env.production's value into that
	// runtime's process.env by itself. Without this, server-side
	// fetchCompanyDetail/fetchSignalDetail silently read
	// api-client.ts's "http://localhost:8787" fallback in production,
	// which fails from inside a Worker with no localhost -- generateMetadata's
	// catch block swallowed the failure and served the generic fallback
	// title/description on every /companies/[slug] and /signals/[signalId]
	// request. `vars` here is how Cloudflare actually populates a
	// deployed Worker's process.env; confirmed missing via `grep` on the
	// built worker.js bundle (the URL string wasn't present anywhere in
	// it) before this fix. Public URL, not a secret -- see api-client.ts's
	// own header comment -- so a plain `vars` entry (not a Secret) is
	// correct and matches .env.production's own value exactly; keep the
	// two in sync by hand if the API Worker is ever renamed/moved.
	"vars": {
		"NEXT_PUBLIC_API_BASE_URL": "https://hiring-signals-api.teycircoder14.workers.dev"
	},
	// Service binding to apps/api (W.4 follow-up, same day): fixing the
	// `vars` entry above surfaced a SECOND, more fundamental problem --
	// Cloudflare returns error 1042 ("Worker tried to fetch from another
	// Worker on the same account over a public workers.dev hostname,
	// disallowed for security/loop-prevention reasons") for any
	// server-side fetch() from this Worker to
	// hiring-signals-api.teycircoder14.workers.dev, confirmed via
	// `wrangler tail`: "error code: 1042" as the raw (non-JSON) response
	// body. The browser calling that same URL client-side is unaffected
	// -- 1042 only applies to Worker-to-Worker fetches on the same
	// account, not browser-to-Worker. A service binding is Cloudflare's
	// documented fix for exactly this case: it routes the call directly
	// between Workers (no public-internet round-trip, no 1042 check) and
	// is also faster than the equivalent public fetch. lib/api-client.ts's
	// server-side call sites (generateMetadata in companies/[slug] and
	// signals/[signalId]) use this binding via getCloudflareContext();
	// the client-side fetch() calls the rest of api-client.ts makes
	// (browser -> API) are unaffected and keep using
	// NEXT_PUBLIC_API_BASE_URL as before.
	"services": [
		{
			"binding": "API",
			"service": "hiring-signals-api"
		}
	]
}
