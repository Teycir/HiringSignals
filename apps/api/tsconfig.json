{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true,
    "outDir": "dist"
  },
  // Only include the specific lib/ subtrees this app imports from. Blanket
  // "../../lib/**/*" would accidentally pick up type-only files from other
  // lib/ modules that this package doesn't have the typings for (e.g. D1 on
  // a non-D1 package) and cause confusing errors later. Pattern: add one
  // entry per actual top-level import:
  //   - lib/kv/ttl-store.ts           (services/raw-payload-store.ts)
  //   - lib/http/security-headers.ts  (middleware/security-headers.ts)
  //   - lib/http/rate-limit.ts        (middleware/anti-abuse.ts tiered policy)
  //   - lib/http/circuit-breaker.ts   (middleware/anti-abuse.ts + repo wrappers)
  //   - lib/http/turnstile.ts         (middleware/anti-abuse.ts admin-write CAPTCHA)
  //   - lib/observability/audit-abuse.ts (middleware/anti-abuse.ts signal logging)
  //   - lib/d1/unique-constraint.ts   (jobs/ingest-consumer.ts observation idempotency)
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../lib/kv/**/*.ts",
    "../../lib/http/**/*.ts",
    "../../lib/observability/**/*.ts",
    "../../lib/d1/unique-constraint.ts"
  ],
  "exclude": ["node_modules", "dist", ".wrangler"]
}
